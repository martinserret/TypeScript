{
  "compilerOptions": {
    "target": "es2022",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "module": "NodeNext",
    "outDir": "dist",
    "lib": ["es2022", "dom"],
    "strict": true,

    "allowImportingTsExtensions": true, // Allows importing .ts files directly
    "noEmit": true, // Prevents emitting JavaScript files, useful for type-checking only
    "verbatimModuleSyntax": true, // Ensures that the module syntax is preserved as-is
  }
}